# Copy this file to .env.local for local development,
# and add the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# TMDB → Settings → API → "API Read Access Token" (the long one).
# This stays on the server and is never sent to the browser.
TMDB_READ_TOKEN=your-tmdb-read-access-token
# Alternatively, the short "API Key" works too (leave TMDB_READ_TOKEN empty then):
# TMDB_API_KEY=

# Two-letter country code used for "In cinemas now" and "Coming soon"
NEXT_PUBLIC_REGION=NZ

# Optional, free: the AI guide. Get a key at https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=
# Optional: pin a Gemini model, e.g. gemini-2.5-flash. Leave empty to pick the newest free Flash model automatically.
GEMINI_MODEL=

# ---- Optional (version 4) ----
# Feedback pings: a free Discord (or Slack) incoming-webhook URL. Without it, feedback still lands in your inbox page.
FEEDBACK_WEBHOOK_URL=
# New-episode notifications. Generate the two keys once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supabase → Project Settings → API Keys → service_role (secret). Only used by the daily notification job.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random text. Vercel sends it with the daily job so nobody else can trigger it.
CRON_SECRET=

# ---- Optional (version 5) ----
# Games: better data with IGDB (free). Make an app at https://dev.twitch.tv/console and paste its Client ID and Secret.
# Without these, games come from Steam's public store search.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Live events near you: a free key from https://developer.ticketmaster.com. Without it, events are added by hand.
TICKETMASTER_API_KEY=
